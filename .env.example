# HTTP server
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Runtime services (set real values locally or in Railway; never commit secrets)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wang_raan
INTERNAL_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional
# APP_VERSION=2026.10.11-abc1234          # version shown by GET /health (defaults to package.json)
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...   # Discord/Slack webhook for contact form alerts

# ── Email OTP (สัญญา v1.3.0) ──
# ส่งรหัสผ่าน Resend — production ที่ไม่ตั้ง: POST /v1/auth/otp/request ตอบ 503 (ล็อกอินด้วยอีเมลไม่ได้)
# RESEND_API_KEY=re_...
# MAIL_FROM="วางร้าน <no-reply@your-domain>"   # โดเมนต้องตั้ง SPF/DKIM/DMARC ที่ Resend แล้ว
# รหัส OTP คงที่สำหรับ E2E เท่านั้น — ตั้งตอน NODE_ENV=production แล้วระบบไม่ยอมเริ่ม
# OTP_TEST_CODE=123456
