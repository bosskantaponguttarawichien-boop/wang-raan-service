{
  "name": "wang-raan-service",
  "version": "0.1.0",
  "private": true,
  "description": "Wang-Raan backend service",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "npm run build && node dist/db/migrate.js up",
    "db:rollback": "npm run build && node dist/db/migrate.js down",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check package.json tsconfig.json eslint.config.js vitest.config.ts src test",
    "format:write": "prettier --write package.json tsconfig.json eslint.config.js vitest.config.ts src test"
  },
  "dependencies": {
    "@bosskantaponguttarawichien-boop/wang-raan-core": "^1.0.0",
    "fastify": "^5.6.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.7"
  }
}
